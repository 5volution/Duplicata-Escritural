   ENDIF
   
RETURN hResult

// --- POST /v1/duplicatas ---
METHOD PostDuplicata( hData ) CLASS TRDEAPI
   LOCAL cBody, hResult
   
   IF hData == NIL
      ::cLastError := "Dados não fornecidos"
      RETURN NIL
   ENDIF
   
   cBody := hb_JsonEncode( hData )
