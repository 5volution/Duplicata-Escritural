// --- GET /liquidacao/v1/duplicatas/{idProcessamento}/{idDuplicata} ---
METHOD GetLiquidacaoDuplicata( cIdProcessamento, cIdDuplicata ) CLASS TRDEAPI
   LOCAL hResult
   
   IF Empty( cIdProcessamento ) .OR. Empty( cIdDuplicata )
      ::cLastError := "ID Processamento ou ID Duplicata não fornecidos"
      RETURN NIL
   ENDIF
   
   hResult := ::Request( "GET", "liquidacao/v1/duplicatas/" + cIdProcessamento + "/" + cIdDuplicata, NIL, NIL )
   
   IF hResult != NIL .AND. hResult["success"]
      ? "=== GET /liquidacao/v1/duplicatas/" + cIdProcessamento + "/" + cIdDuplicata + " ==="
      ? "Status:", hResult["status_code"]
      ? "Dados:", hb_JsonEncode( hb_HGetDef( hResult["data"], "data", {=>} ) )
