// --- GET /v1/duplicatas ---
METHOD GetDuplicatas( hParams ) CLASS TRDEAPI
   LOCAL hResult
   LOCAL hDefaultParams := {=>}
   
   hDefaultParams["page"] := "1"
   hDefaultParams["page-size"] := "10"
   
   IF hParams != NIL
      hb_HMerge( hDefaultParams, hParams )
   ENDIF
   
   hResult := ::Request( "GET", "v1/duplicatas", hDefaultParams, NIL )
   
   IF hResult != NIL .AND. hResult["success"]
      ? "=== GET /v1/duplicatas ==="
      ? "Status:", hResult["status_code"]
      ? "Total Registros:", hb_JsonEncode( hb_HGetDef( hResult["data"], "meta", {=>} ) )
      ? "Resposta:", hResult["raw_response"]
   ELSEIF hResult != NIL
      ::cLastError := hb_HGetDef( hResult, "error", "Erro desconhecido" )
      ? "Erro:", ::cLastError
   ENDIF
   
RETURN hResult

// --- GET /v1/duplicatas/{idDuplicata} ---
METHOD GetDuplicataById( cIdDuplicata, cNumeroOrdem ) CLASS TRDEAPI
   LOCAL hParams := {=>}, hResult
   
   IF Empty( cIdDuplicata )
      ::cLastError := "ID da duplicata não fornecido"
      RETURN NIL
   ENDIF
   
   IF !Empty( cNumeroOrdem )
      hParams["numeroOrdem"] := cNumeroOrdem
   ENDIF
   
   hResult := ::Request( "GET", "v1/duplicatas/" + cIdDuplicata, hParams, NIL )
   
   IF hResult != NIL .AND. hResult["success"]
      ? "=== GET /v1/duplicatas/" + cIdDuplicata + " ==="
      ? "Status:", hResult["status_code"]
      ? "Dados:", hb_JsonEncode( hb_HGetDef( hResult["data"], "data", {=>} ) )
      ? "Resposta:", hResult["raw_response"]
   ELSEIF hResult != NIL
      ::cLastError := hb_HGetDef( hResult, "error", "Erro desconhecido" )
      ? "Erro:", ::cLastError
   ENDIF
   
RETURN hResult

